# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# REPLIERS_API_KEY: Optional. Your live TRREB MLS feed API key from repliers.io.
# If not specified, the application will gracefully fall back to the high-quality simulated listing generator.
REPLIERS_API_KEY="YOUR_REPLIERS_API_KEY"

# AMPRE_API_TOKEN: Optional. Your live TRREB MLS RESO Web API token from ampre.ca / PropTx.
# This is the 100% secure token from your Ampre token files.
AMPRE_API_TOKEN="YOUR_AMPRE_API_TOKEN"

# AMPRE_API_URL: Optional. Default is https://query.ampre.ca/odata
AMPRE_API_URL="https://query.ampre.ca/odata"

